# Copiar a .env y ajustar valores.
# En producción: definir SECRET_KEY con un valor aleatorio fuerte (ej. openssl rand -hex 32).

# Base de datos (opcional; por defecto usa backend/sql_app.db)
# DATABASE_URL=sqlite+aiosqlite:///sql_app.db

SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
LOG_LEVEL=INFO
DATABASE_ECHO=false

# OpenAI (opcional)
# OPENAI_API_KEY=

# Google OAuth (opcional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FRONTEND_URL=http://localhost:5173

# Facebook OAuth (opcional)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Admin: emails superadmin separados por coma
# SUPERADMIN_EMAILS=
